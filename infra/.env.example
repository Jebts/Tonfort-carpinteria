# Variables de entorno para n8n self-hosted (F1)
# Copia a `.env` y completa los valores reales. NUNCA commitees el .env.
# Origen: docs/Herramientas_del_Proyecto.md §10 (v5) + README.

# ---- n8n ----
# Clave de cifrado de credenciales de n8n (genera con: openssl rand -base64 48)
N8N_ENCRYPTION_KEY=
# Dominio donde se expone n8n (debe apuntar a este VPS y coincidir con Caddyfile)
N8N_HOST=n8n.tudominio.com

# ---- LLM (Gemini 2.5 Flash, Google AI Studio) ----
GEMINI_API_KEY=

# ---- Supabase (app DB + Auth) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=

# ---- Meta WhatsApp ----
META_VERIFY_TOKEN=
META_APP_SECRET=

# ---- Wompi (COP) ----
WOMPI_PRIVATE_KEY=
WOMPI_PUBLIC_KEY=
WOMPI_EVENTS_SECRET=

# ---- SMTP (Resend propuesto) ----
RESEND_API_KEY=
