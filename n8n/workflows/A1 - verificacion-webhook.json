{
  "name": "A1 - verificacion-webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "a1-verify",
        "responseMode": "onReceived"
      },
      "name": "1. Webhook verificacion (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "a1-verify"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "={{ $env.META_VERIFY_TOKEN }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "name": "2. Validar META_VERIFY_TOKEN",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}"
      },
      "name": "3. Responder challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [780, 200]
    },
    {
      "parameters": {
        "statusCode": 403,
        "responseBody": "verificacion rechazada"
      },
      "name": "4. Rechazar (403)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [780, 420]
    }
  ],
  "connections": {
    "1. Webhook verificacion (GET)": {
      "main": [ [ { "node": "2. Validar META_VERIFY_TOKEN", "type": "main", "index": 0 } ] ]
    },
    "2. Validar META_VERIFY_TOKEN": {
      "main": [
        [ { "node": "3. Responder challenge", "type": "main", "index": 0 } ],
        [ { "node": "4. Rechazar (403)", "type": "main", "index": 0 } ]
      ]
    }
  },
  "settings": {
    "errorWorkflow": "_Error Handler - notificacion",
    "executionOrder": "v1"
  },
  "active": false,
  "tags": ["F4", "meta", "webhook"]
}
