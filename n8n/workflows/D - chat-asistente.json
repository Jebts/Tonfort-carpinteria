{
  "name": "D - chat-asistente",
  "nodes": [
    {
      "parameters": {},
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET app.tenant_id = '{{ $json.empresa_id }}';",
        "queryParameters": { "parameter": [] }
      },
      "name": "0. SET tenant_id (app_tenant)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [480, 400],
      "credentials": { "postgres": { "id": "POSTGRES_APP_TENANT", "name": "Postgres - app_tenant" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT e.instrucciones_md, e.identidad, e.horario_atencion, u.nombre, u.rol\nFROM empresas e\nJOIN usuarios_empresa u ON u.empresa_id = e.id\nWHERE e.id = current_setting('app.tenant_id')::uuid AND u.id = $1;",
        "queryParameters": { "parameter": [ { "value": "={{ $json.usuario_id }}" } ] }
      },
      "name": "1. Cargar perfil staff + empresa (app_tenant)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [720, 400],
      "credentials": { "postgres": { "id": "POSTGRES_APP_TENANT", "name": "Postgres - app_tenant" } }
    },
    {
      "parameters": {
        "jsCode": "const r = $('1. Cargar perfil staff + empresa (app_tenant)').item.json;\nconst entrada = $('Execute Workflow Trigger').item.json;\nconst sistema = 'Eres el asistente interno del negocio para su equipo (rol: ' + (r.rol||'staff') + '). ' +\n  'Ayuda con autoservicio: consultar citas, horarios y herramientas internas. ' +\n  'No des informacion de otros tenants. ' +\n  'Contexto del negocio: ' + (r.instrucciones_md||'') + '\\n' +\n  'Identidad: ' + (typeof r.identidad==='object'?JSON.stringify(r.identidad):(r.identidad||''));\nconst prompt = sistema + '\\n\\nMensaje del staff (' + (r.nombre||'') + '): ' + (entrada.mensaje||'');\nreturn [{ json: { prompt } }];"
      },
      "name": "1b. Ensamblar prompt staff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={{$env.GEMINI_API_KEY}}",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ contents:[{parts:[{text: $json.prompt}]}], generationConfig:{ temperature:0.4, maxOutputTokens:1024 } }) }}"
      },
      "name": "2. Llamar Gemini 2.5 Flash (HTTP Request)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1200, 400]
    },
    {
      "parameters": {
        "jsCode": "const c = $json.candidates?.[0]?.content?.parts?.map(p=>p.text).join('') ?? '';\nreturn [{ json: { respuesta: c } }];"
      },
      "name": "3. Extraer respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT identificador_externo, credenciales_encriptadas->>'access_token' AS access_token\nFROM integraciones\nWHERE empresa_id = current_setting('app.tenant_id')::uuid AND tipo = 'whatsapp' AND estado = 'activo' AND deleted_at IS NULL\nLIMIT 1;",
        "queryParameters": { "parameter": [] }
      },
      "name": "4. Obtener linea WhatsApp activa (app_tenant)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1680, 400],
      "credentials": { "postgres": { "id": "POSTGRES_APP_TENANT", "name": "Postgres - app_tenant" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{ $json.identificador_externo }}/messages",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "Bearer {{ $json.access_token }}" } ] },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ messaging_product:'whatsapp', to: $('Execute Workflow Trigger').item.json.telefono, type:'text', text:{ body: $('3. Extraer respuesta').item.json.respuesta } }) }}"
      },
      "name": "4b. Enviar respuesta WhatsApp (HTTP Request)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1920, 400]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [ [ { "node": "0. SET tenant_id (app_tenant)", "type": "main", "index": 0 } ] ] },
    "0. SET tenant_id (app_tenant)": { "main": [ [ { "node": "1. Cargar perfil staff + empresa (app_tenant)", "type": "main", "index": 0 } ] ] },
    "1. Cargar perfil staff + empresa (app_tenant)": { "main": [ [ { "node": "1b. Ensamblar prompt staff", "type": "main", "index": 0 } ] ] },
    "1b. Ensamblar prompt staff": { "main": [ [ { "node": "2. Llamar Gemini 2.5 Flash (HTTP Request)", "type": "main", "index": 0 } ] ] },
    "2. Llamar Gemini 2.5 Flash (HTTP Request)": { "main": [ [ { "node": "3. Extraer respuesta", "type": "main", "index": 0 } ] ] },
    "3. Extraer respuesta": { "main": [ [ { "node": "4. Obtener linea WhatsApp activa (app_tenant)", "type": "main", "index": 0 } ] ] },
    "4. Obtener linea WhatsApp activa (app_tenant)": { "main": [ [ { "node": "4b. Enviar respuesta WhatsApp (HTTP Request)", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "errorWorkflow": "_Error Handler - notificacion", "executionOrder": "v1" },
  "active": false,
  "tags": ["F4", "chat-asistente", "sub-workflow", "staff"]
}
