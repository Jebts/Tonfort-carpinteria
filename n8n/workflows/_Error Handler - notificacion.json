{
  "name": "_Error Handler - notificacion",
  "nodes": [
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "fromEmail": "errores@tonfort.app",
        "toEmail": "ops@tonfort.app",
        "subject": "=[Tonfort] Error en workflow: {{ $json.workflow.name }}",
        "emailFormat": "text",
        "message": "Workflow: {{ $json.workflow.name }}\nEjecución: {{ $json.execution.id }}\nError: {{ $json.error.message }}\n\n{{ $json.error.stack }}"
      },
      "name": "Send Email (SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [520, 300],
      "credentials": { "smtp": { "id": "RESEND_SMTP", "name": "Resend - SMTP" } }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [ [ { "node": "Send Email (SMTP)", "type": "main", "index": 0 } ] ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": ["F4", "error-handler"]
}
