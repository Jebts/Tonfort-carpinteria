# Variables de entorno — tonfort (carpintería)
# COPIA DE .env SIN VALORES REALES. NUNCA pongas secretos aquí; este archivo
# SÍ se commitea (solo .env está en .gitignore).
# Uso: cp .env.example .env  y completa los valores reales.
# Levantar con: docker compose up -d  (desde la RAÍZ del repo).

# =====================================================================
# CONFIGURACIONES DEL SERVIDOR (VPS, DNS, Caddy)
# =====================================================================

VPS_HOST=
VPS_USER=root
VPS_SSH_PORT=22
VPS_SSH_KEY=
VPS_REMOTE_DIR=/opt/tonfort

DOMAIN=tu-dominio.co
CARPINTERIA_HOST_IP=
CARPINTERIA_HOST=carpinteria.{DOMAIN}
CADDY_EMAIL=admin@tu-dominio.co
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# =====================================================================
# LLMs (configurable: groq=prueba, openai=produccion, mock=determinista)
# =====================================================================
# IMPORTANTE: estas variables se leen SIN prefijo CARPINTERIA_*.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =====================================================================
# BACKEND CARPINTERÍA (Supabase propio, single-tenant)
# =====================================================================
CARPINTERIA_SUPABASE_URL=
CARPINTERIA_SUPABASE_SERVICE_ROLE_KEY=
# Opcional: hoy el público usa service_role (getServiceSupabase). Se deja por
# paridad con docker-compose.yml, pero no se consume en runtime.
CARPINTERIA_SUPABASE_ANON_KEY=

# =====================================================================
# AUTH STAFF
# =====================================================================
# Auth: usuarios en DB (tabla usuarios). Login email/password con hash scrypt.
# El admin inicial se crea con INITIAL_ADMIN_PASSWORD via seed-admin.ts.
# No se usa STAFF_CREDENTIALS (eliminado del flujo activo).
# Roles:
#   admin     → acceso completo (Usuarios, Portafolio, Proyectos, Clientes, Agenda, Citas)
#   asesor    → Clientes, Agenda, Citas, lectura de diseño/enlaces
#   disenador → Proyectos/Productos/Propuestas/Animaciones en proyectos asignados
SESSION_SECRET=cambia-este-secreto-largo
INITIAL_ADMIN_PASSWORD=cambia-esta-contrasena-admin-123

# =====================================================================
# CONTACTO (NEXT_PUBLIC_* horneadas en build — leídas por lib/contact.ts)
# =====================================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=3127916632
NEXT_PUBLIC_INSTAGRAM_HANDLE=tonfort.muebles
NEXT_PUBLIC_EMAIL=ventas@tonfort.com

# Paridad Docker/VPS: docker-compose.yml mapea estas a las NEXT_PUBLIC_*
# anteriores como build args, y vps-deploy.sh las lista como requeridas.
CARPINTERIA_WHATSAPP_NUMBER=3127916632
CARPINTERIA_INSTAGRAM_HANDLE=tonfort.muebles
CARPINTERIA_EMAIL=ventas@tonfort.com
