# Variables de entorno — tonfort (carpintería)
# COPIA DE .env SIN VALORES REALES. NUNCA pongas secretos aquí; este archivo
# SÍ se commitea (solo .env está en .gitignore).
# Uso: cp .env.example .env  y completa los valores reales.
# Levantar con: docker compose up -d  (desde la RAÍZ del repo).

# =====================================================================
# CONFIGURACIONES DEL SERVIDOR (VPS, DNS, Caddy)
# =====================================================================

VPS_HOST=
VPS_USER=root
VPS_SSH_PORT=22
VPS_SSH_KEY=
VPS_REMOTE_DIR=/opt/tonfort

DOMAIN=tu-dominio.co
CARPINTERIA_HOST_IP=
CARPINTERIA_HOST=carpinteria.{DOMAIN}
CADDY_EMAIL=admin@tu-dominio.co
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# =====================================================================
# LLMs (configurable: groq=prueba, openai=produccion, mock=determinista)
# =====================================================================
# IMPORTANTE: estas variables se leen SIN prefijo CARPINTERIA_*.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =====================================================================
# BACKEND CARPINTERÍA (Supabase propio, single-tenant)
# =====================================================================
CARPINTERIA_SUPABASE_URL=
CARPINTERIA_SUPABASE_SERVICE_ROLE_KEY=
CARPINTERIA_SUPABASE_ANON_KEY=

# =====================================================================
# AUTH STAFF
# =====================================================================
# Genera hashes con: node db/scripts/migrate-staff-hash.mjs
STAFF_CREDENTIALS='[{"usuario":"admin","password_hash":"","nombre":"Edwin Bustos"}]'
SESSION_SECRET=cambia-este-secreto-largo
